function RER_isPerformanceModeEnabled(): bool {
  return RER_menuBool(
    'RERmain',
    'RERperformanceMode',
    true // TODO: maybe read the graphics settings or something?
  );
}

function RER_performanceModeEither<T>(a: T, b: T): T {
  if (RER_isPerformanceModeEnabled()) {
    return b;
  }

  return a;
}