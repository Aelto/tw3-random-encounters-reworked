
function RER_tutorialTryShowEcosystem(): bool {
  if (!RER_tutorialWasSeen('RERtutorialEcosystem')) {
    return false;
  }

  RER_toggleHUD();
  NTUTO(
    GetLocStringByKey("rer_tutorial_ecosystem_title"),
    GetLocStringByKey("rer_tutorial_ecosystem_body")
  );
  RER_toggleHUD();

  RER_tutorialSetSeen('RERtutorialEcosystem');

  theGame.SaveUserSettings();

  return true;
}