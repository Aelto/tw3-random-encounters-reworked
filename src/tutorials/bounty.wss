
function RER_tutorialTryShowBounty(): bool {
  if (!RER_tutorialWasSeen('RERtutorialBountyHunting')) {
    return false;
  }

  RER_toggleHUD();
  NTUTO(
    GetLocStringByKey("rer_tutorial_bounty_title"),
    GetLocStringByKey("rer_tutorial_bounty_body")
  );
  RER_toggleHUD();

  RER_tutorialSetSeen('RERtutorialBountyHunting');

  theGame.SaveUserSettings();

  return true;
}