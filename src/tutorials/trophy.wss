
function RER_tutorialTryShowTrophy(): bool {
  if (!RER_tutorialWasSeen('RERtutorialTrophy')) {
    return false;
  }

  RER_toggleHUD();
  NTUTO(
    GetLocStringByKey("rer_tutorial_rewards_title"),
    GetLocStringByKey("rer_tutorial_rewards_body")
  );
  RER_toggleHUD();

  RER_tutorialSetSeen('RERtutorialTrophy');

  theGame.SaveUserSettings();

  return true;
}