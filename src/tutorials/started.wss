
function RER_tutorialTryShowStarted(): bool {
  if (!RER_tutorialWasSeen('RERtutorialStarted')) {
    return false;
  }

  RER_toggleHUD();
  NTUTO(
    GetLocStringByKey("rer_tutorial_started_title"),
    GetLocStringByKey("rer_tutorial_started_body")
  );
  RER_toggleHUD();

  RER_tutorialSetSeen('RERtutorialStarted');

  theGame.SaveUserSettings();

  return true;
}