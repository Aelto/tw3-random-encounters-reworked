
function RER_tutorialTryShowAmbushed(): bool {
  if (!RER_tutorialWasSeen('RERtutorialAmbushed')) {
    return false;
  }

  RER_toggleHUD();
  NTUTO(
    GetLocStringByKey("rer_tutorial_ambush_title"),
    GetLocStringByKey("rer_tutorial_ambush_body")
  );
  RER_toggleHUD();

  RER_tutorialSetSeen('RERtutorialAmbushed');

  theGame.SaveUserSettings();

  return true;
}