
function RER_tutorialTryShowClue(): bool {
  if (!RER_tutorialWasSeen('RERtutorialClueExamined')) {
    return false;
  }

  RER_toggleHUD();
  NTUTO(
    GetLocStringByKey("rer_tutorial_clue_title"),
    GetLocStringByKey("rer_tutorial_clue_body")
  );
  RER_toggleHUD();

  RER_tutorialSetSeen('RERtutorialClueExamined');

  theGame.SaveUserSettings();

  return true;
}