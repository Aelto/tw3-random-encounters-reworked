
function RER_tutorialTryShowContract(): bool {
  if (!RER_tutorialWasSeen('RERtutorialMonsterContract')) {
    return false;
  }

  RER_toggleHUD();
  NTUTO(
    GetLocStringByKey("rer_tutorial_contract_title"),
    GetLocStringByKey("rer_tutorial_contract_body")
  );
  RER_toggleHUD();


  RER_tutorialSetSeen('RERtutorialMonsterContract');

  theGame.SaveUserSettings();

  return true;
}